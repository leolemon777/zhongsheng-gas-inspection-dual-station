<Window x:Class="ZhongshengGasInspectionHmi.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ZhongshengGasInspectionHmi.UI.ViewModels"
        Title="中央净软气检工装"
        Icon="Assets/AppIcon.ico"
        Width="1280"
        Height="860"
        MinWidth="1120"
        MinHeight="760"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F2F0EB"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}">
    <Window.Resources>
        <SolidColorBrush x:Key="Brush.Page" Color="#F2F0EB" />
        <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="#F8FAF9" />
        <SolidColorBrush x:Key="Brush.Border" Color="#E3E0DA" />
        <SolidColorBrush x:Key="Brush.Primary" Color="#00754A" />
        <SolidColorBrush x:Key="Brush.PrimaryDark" Color="#1E3932" />
        <SolidColorBrush x:Key="Brush.PrimarySoft" Color="#D4E9E2" />
        <SolidColorBrush x:Key="Brush.Accent" Color="#CBA258" />
        <SolidColorBrush x:Key="Brush.AccentSoft" Color="#F6E8C8" />
        <SolidColorBrush x:Key="Brush.Text" Color="#1E3932" />
        <SolidColorBrush x:Key="Brush.TextMuted" Color="#5B6C65" />
        <SolidColorBrush x:Key="Brush.Ok" Color="#15803D" />
        <SolidColorBrush x:Key="Brush.Ng" Color="#B91C1C" />
        <SolidColorBrush x:Key="Brush.Warn" Color="#C2410C" />
        <SolidColorBrush x:Key="Brush.White" Color="#FFFFFF" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MicroTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryDark}" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PanelTitleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryDark}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
            <Setter Property="FontSize" Value="42" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="SoftCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceMuted}" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="PillBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,7" />
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryDark}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#E8E5DF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#E8E5DF" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Ng}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Ng}" />
        </Style>

        <Style x:Key="RunActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="42" />
        </Style>

        <Style x:Key="RunPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="42" />
        </Style>

        <Style x:Key="RunDangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="42" />
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{StaticResource Brush.Page}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Page}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryDark}" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimarySoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ThemedGridViewColumnHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryDark}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="ThemedListViewItemStyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryDark}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.SurfaceMuted}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryDark}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThemedListViewStyle" TargetType="{x:Type ListView}">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedListViewItemStyle}" />
            <Setter Property="GridView.ColumnHeaderContainerStyle" Value="{StaticResource ThemedGridViewColumnHeaderStyle}" />
        </Style>

        <DataTemplate DataType="{x:Type vm:RunPageViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="中央净软气检工装" Style="{StaticResource PageTitleTextStyle}" />
                            <TextBlock Text="{Binding StationText}" Style="{StaticResource PanelTitleTextStyle}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding OperatorMessage}" Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource PillBorderStyle}" Margin="0,0,10,0">
                                <TextBlock Text="{Binding StationMappingText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.PrimaryDark}" />
                            </Border>
                            <Border Style="{StaticResource PillBorderStyle}" Margin="0,0,10,0">
                                <TextBlock Text="{Binding HardwareStatus}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.PrimaryDark}" />
                            </Border>
                            <Border Background="{DynamicResource Brush.Primary}" CornerRadius="6" Padding="16,8">
                                <TextBlock Text="{Binding StageText}" FontWeight="SemiBold" Foreground="{StaticResource Brush.White}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SoftCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="产品条码" Style="{StaticResource CaptionTextStyle}" />
                            <TextBox Text="{Binding ProductCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SoftCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="充气时间" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{Binding FillTimeText}" Style="{StaticResource PanelTitleTextStyle}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource SoftCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="稳压时间" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{Binding StabilizeTimeText}" Style="{StaticResource PanelTitleTextStyle}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource SoftCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="保压时间" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{Binding HoldTimeText}" Style="{StaticResource PanelTitleTextStyle}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="8" Style="{StaticResource SoftCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="允许漏率" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{Binding LeakLimitText}" Style="{StaticResource PanelTitleTextStyle}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.95*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="实时压力" Style="{StaticResource PanelTitleTextStyle}" />
                            <Grid Grid.Row="1" Width="250" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Fill="{DynamicResource Brush.Primary}" />
                                <Ellipse Fill="{StaticResource Brush.Surface}" Margin="24" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PressureValueText}" Style="{StaticResource MetricTextStyle}" TextAlignment="Center" />
                                    <TextBlock Text="kPa" Foreground="{DynamicResource Brush.Primary}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentMilliampText}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Style="{StaticResource PillBorderStyle}" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PressurePointText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.PrimaryDark}" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="检测数据与流程" Style="{StaticResource PanelTitleTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding ResultText}" Foreground="{DynamicResource Brush.Primary}" FontSize="24" FontWeight="SemiBold" />
                            </Grid>

                            <UniformGrid Grid.Row="1" Columns="5" Margin="0,14,0,12">
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="P1" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding P1Text}" Style="{StaticResource PanelTitleTextStyle}" Margin="0,8,0,0" />
                                        <TextBlock Text="kPa" Style="{StaticResource MicroTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="P2" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding P2Text}" Style="{StaticResource PanelTitleTextStyle}" Margin="0,8,0,0" />
                                        <TextBlock Text="kPa" Style="{StaticResource MicroTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="实际漏率" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding LeakRateText}" Style="{StaticResource PanelTitleTextStyle}" Margin="0,8,0,0" />
                                        <TextBlock Text="(P1-P2)/P1" Style="{StaticResource MicroTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="允许漏率" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding LeakLimitText}" Style="{StaticResource PanelTitleTextStyle}" Margin="0,8,0,0" />
                                        <TextBlock Text="参数设定" Style="{StaticResource MicroTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource Brush.PrimarySoft}" BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="判定" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding ResultText}" Style="{StaticResource PanelTitleTextStyle}" Margin="0,8,0,0" />
                                        <TextBlock Text="OK / NG" Style="{StaticResource MicroTextStyle}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="2"
                                    Background="{StaticResource Brush.SurfaceMuted}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.85*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="0.85*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="当前步骤剩余" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding StageRemainingText}"
                                                   Foreground="{DynamicResource Brush.Primary}"
                                                   FontSize="34"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StageTimeText}"
                                                   Foreground="{DynamicResource Brush.PrimaryDark}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <ProgressBar Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding StageProgressPercent}"
                                                     Height="12"
                                                     Margin="0,10,0,0"
                                                     Foreground="{DynamicResource Brush.Primary}"
                                                     Background="{StaticResource Brush.Border}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="总运行时间" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding TotalRunTimeText}"
                                                   Foreground="{DynamicResource Brush.PrimaryDark}"
                                                   FontSize="34"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="3" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="启动" Command="{Binding StartCommand}" AutomationProperties.AutomationId="RunStartButton" Style="{StaticResource RunPrimaryActionButtonStyle}" />
                                <Button Grid.Column="2" Content="停止" Command="{Binding StopCommand}" AutomationProperties.AutomationId="RunStopButton" Style="{StaticResource RunDangerActionButtonStyle}" />
                                <Button Grid.Column="4" Content="手动排气" Command="{Binding ExhaustCommand}" AutomationProperties.AutomationId="RunExhaustButton" Style="{StaticResource RunActionButtonStyle}" />
                            </Grid>

                            <ItemsControl Grid.Row="4" ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="5" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="StepBorder"
                                                Background="{StaticResource Brush.SurfaceMuted}"
                                                BorderBrush="{StaticResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10"
                                                Margin="0,0,8,0"
                                                MinHeight="136">
                                            <StackPanel>
                                                <Border x:Name="StepIndex" Width="30" Height="30" Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="15" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Order}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.PrimaryDark}" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock x:Name="StepName" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,4" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MicroTextStyle}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="StepTime" Text="{Binding TimeText}" Foreground="{StaticResource Brush.TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" />
                                                <TextBlock x:Name="StepStatus" Text="{Binding Status}" Foreground="{DynamicResource Brush.Primary}" FontWeight="SemiBold" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="进行中">
                                                <Setter TargetName="StepBorder" Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                                                <Setter TargetName="StepBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                <Setter TargetName="StepIndex" Property="Background" Value="{StaticResource Brush.Accent}" />
                                                <Setter TargetName="StepTime" Property="Foreground" Value="{DynamicResource Brush.PrimaryDark}" />
                                                <Setter TargetName="StepStatus" Property="Foreground" Value="{StaticResource Brush.Warn}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="完成">
                                                <Setter TargetName="StepBorder" Property="Background" Value="{DynamicResource Brush.PrimaryDark}" />
                                                <Setter TargetName="StepBorder" Property="BorderBrush" Value="{DynamicResource Brush.PrimaryDark}" />
                                                <Setter TargetName="StepIndex" Property="Background" Value="{DynamicResource Brush.Primary}" />
                                                <Setter TargetName="StepName" Property="Foreground" Value="{StaticResource Brush.White}" />
                                                <Setter TargetName="StepTime" Property="Foreground" Value="{StaticResource Brush.White}" />
                                                <Setter TargetName="StepStatus" Property="Foreground" Value="{StaticResource Brush.White}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.RowSpan="3"
                      Panel.ZIndex="20"
                      Background="#AA1E3932">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNgWarningVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Ng}"
                            BorderThickness="4"
                            CornerRadius="8"
                            Padding="36"
                            Width="560"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="NG"
                                       Foreground="{StaticResource Brush.Ng}"
                                       FontSize="86"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="本台检测不合格"
                                       Foreground="{StaticResource Brush.Ng}"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,22" />
                            <Border Background="{StaticResource Brush.SurfaceMuted}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="18"
                                    Margin="0,0,0,24">
                                <TextBlock Text="{Binding NgWarningMessage}"
                                           TextWrapping="Wrap"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           LineHeight="30" />
                            </Border>
                            <Button Content="确认"
                                    Command="{Binding ConfirmNgWarningCommand}"
                                    AutomationProperties.AutomationId="RunConfirmNgWarningButton"
                                    Style="{StaticResource DangerButtonStyle}"
                                    MinHeight="64"
                                    FontSize="22" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="气检工艺参数" Style="{StaticResource PageTitleTextStyle}" />
                            <TextBlock Text="{Binding StationText}" Style="{StaticResource PanelTitleTextStyle}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SaveMessage}" Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="保存参数" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SettingsSaveButton" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Grid.Row="1"
                        Background="{DynamicResource Brush.PrimarySoft}"
                        BorderBrush="{DynamicResource Brush.Primary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="流程顺序" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="充气 -> 稳压 -> P1 -> 保压 -> P2 -> 判定"
                                           Foreground="{DynamicResource Brush.PrimaryDark}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="漏率公式" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="(P1 - P2) / P1"
                                           Foreground="{DynamicResource Brush.PrimaryDark}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="排气策略" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding ExhaustMode}"
                                           Foreground="{StaticResource Brush.Warn}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="时序参数" Style="{StaticResource PanelTitleTextStyle}" />
                            <UniformGrid Columns="2" Margin="0,16,0,0">
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="充气时间 s" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding FillSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="稳压时间 s" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding StabilizeSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="保压时间 s" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding HoldSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="允许漏率" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding MaxLeakRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="压力与手动排气" Style="{StaticResource PanelTitleTextStyle}" />
                            <UniformGrid Columns="2" Margin="0,16,0,0">
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="4mA 对应压力 MPa" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding PressureAt4Milliamp, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="20mA 对应压力 MPa" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding PressureAt20Milliamp, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="安全拔管压力 MPa" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding SafeExhaustPressure, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="排气方式" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="现场手动排气" FontWeight="SemiBold" Foreground="{DynamicResource Brush.PrimaryDark}" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="手动排气观察时间 s" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding ExhaustSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="最小充气升压 MPa（不拦截）" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding MinimumFillPressureRise, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="最大允许压力 MPa（不拦截）" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding MaximumAllowedPressure, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="测试模式" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="压力、电流、升压异常不拦截流程；仅停止命令或通讯失败会中断" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Brush.PrimaryDark}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HardwarePageViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="模块连接" Style="{StaticResource PageTitleTextStyle}" />
                            <TextBlock Text="{Binding StationMappingText}" Style="{StaticResource PanelTitleTextStyle}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="保存配置" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="HardwareSaveButton" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0" />
                            <Button Content="连接" Command="{Binding ConnectCommand}" AutomationProperties.AutomationId="HardwareConnectButton" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" />
                            <Button Content="读取压力" Command="{Binding ReadPressureCommand}" AutomationProperties.AutomationId="HardwareReadPressureButton" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0" />
                            <CheckBox Content="{Binding AutoRefreshText}"
                                      IsChecked="{Binding IsAutoRefreshPressure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.AutomationId="HardwareAutoRefreshCheckBox"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"
                                      Foreground="{DynamicResource Brush.PrimaryDark}"
                                      FontWeight="SemiBold" />
                            <Button Content="断开" Command="{Binding DisconnectCommand}" AutomationProperties.AutomationId="HardwareDisconnectButton" Style="{StaticResource BaseButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Modbus 通信参数" Style="{StaticResource PanelTitleTextStyle}" />
                            <TextBlock Text="两个模块出厂 IP 都可能是 192.168.0.7，正式接线前应先改成不同地址。" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,16" />
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="当前上位机工位" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding ActiveStationId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="工位名称" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding StationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="协议模式" Style="{StaticResource CaptionTextStyle}" />
                                        <CheckBox Content="RTU over TCP"
                                                  IsChecked="{Binding UseRtuOverTcp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,12,0,0"
                                                  Foreground="{DynamicResource Brush.PrimaryDark}"
                                                  FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ProtocolText}" Style="{StaticResource MicroTextStyle}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Modbus 站号" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding ModbusUnitId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="数字量模块 IP" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding IoModuleIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="数字量模块端口" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding IoModulePort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="模拟量模块 IP" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding AnalogModuleIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="模拟量模块端口" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding AnalogModulePort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="点位映射" Style="{StaticResource PanelTitleTextStyle}" />
                            <UniformGrid Columns="2" Margin="0,16,0,0">
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="进气阀打开线圈" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding InletOpenCoil, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="进气阀关闭线圈" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding InletCloseCoil, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="压力寄存器" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding PressureRegister, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="阀门动作通电时间 ms" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding ValvePulseMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="模拟量固定小数位" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox Text="{Binding AnalogFixedDecimalPlaces, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="当前映射" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding StationMappingText}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Brush.PrimaryDark}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="最近原始值" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding LastRawRegisterText}" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding LastVoltageText}" Style="{StaticResource MicroTextStyle}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SoftCardBorderStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="换算结果" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding LastCurrentMilliampText}" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding LastPressureText}" Style="{StaticResource MicroTextStyle}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ModbusLogPageViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Modbus 通信日志" Style="{StaticResource PageTitleTextStyle}" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="清空日志"
                                Command="{Binding ClearLogsCommand}"
                                AutomationProperties.AutomationId="ModbusLogClearButton"
                                Style="{StaticResource BaseButtonStyle}"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                    <ListView ItemsSource="{Binding CommunicationLogs}"
                              Style="{StaticResource ThemedListViewStyle}"
                              FontFamily="Consolas"
                              FontSize="12"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="时间" DisplayMemberBinding="{Binding Time, StringFormat='HH:mm:ss.fff'}" Width="105" />
                                <GridViewColumn Header="方向" DisplayMemberBinding="{Binding Direction}" Width="48" />
                                <GridViewColumn Header="协议" DisplayMemberBinding="{Binding Transport}" Width="110" />
                                <GridViewColumn Header="端点" DisplayMemberBinding="{Binding Endpoint}" Width="150" />
                                <GridViewColumn Header="功能码" DisplayMemberBinding="{Binding FunctionCode}" Width="135" />
                                <GridViewColumn Header="地址" DisplayMemberBinding="{Binding AddressText}" Width="70" />
                                <GridViewColumn Header="说明" DisplayMemberBinding="{Binding Detail}" Width="230" />
                                <GridViewColumn Header="帧" DisplayMemberBinding="{Binding HexFrame}" Width="470" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:IoMonitorPageViewModel}">
            <Grid>
                <Grid.Resources>
                    <Style x:Key="IoAutoModeButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                        <Setter Property="MinWidth" Value="116" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsManualMode}" Value="False">
                                <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="IoManualModeButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                        <Setter Property="MinWidth" Value="116" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsManualMode}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Warn}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Warn}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="4IO 点位监控" Style="{StaticResource PageTitleTextStyle}" />
                            <Border CornerRadius="8"
                                    Padding="14,8"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Brush.PrimaryDark}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryDark}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsManualMode}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Warn}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Warn}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="当前：" Foreground="{StaticResource Brush.White}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ModeText}" Foreground="{StaticResource Brush.White}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text=" · " Foreground="{StaticResource Brush.White}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ModeDetailText}" Foreground="{StaticResource Brush.White}" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="自动" Command="{Binding SetAutoModeCommand}" AutomationProperties.AutomationId="IoAutoModeButton" Style="{StaticResource IoAutoModeButtonStyle}" Margin="0,0,10,0" />
                            <Button Content="手动" Command="{Binding SetManualModeCommand}" AutomationProperties.AutomationId="IoManualModeButton" Style="{StaticResource IoManualModeButtonStyle}" Margin="0,0,10,0" />
                            <Button Content="刷新" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="IoRefreshButton" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0" />
                            <Button Content="复位" Command="{Binding ResetOutputsCommand}" AutomationProperties.AutomationId="IoResetOutputsButton" Style="{StaticResource BaseButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="输入点 DI1 - DI4" Style="{StaticResource PanelTitleTextStyle}" />
                                <TextBlock Text="功能码 02H，协议地址 0000H - 0003H" Style="{StaticResource MicroTextStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Inputs}" Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Brush.SurfaceMuted}"
                                                BorderBrush="{StaticResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="16"
                                                Margin="0,0,10,10"
                                                MinHeight="124">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Address}" FontSize="24" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ProtocolAddress}" Style="{StaticResource MicroTextStyle}" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MicroTextStyle}" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource Brush.Primary}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="输出点 DO1 - DO4" Style="{StaticResource PanelTitleTextStyle}" />
                                <TextBlock Text="{Binding OutputMappingText}" Style="{StaticResource MicroTextStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Outputs}" Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ToggleOutputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanOperate}"
                                                Style="{StaticResource BaseButtonStyle}"
                                                Margin="0,0,10,10"
                                                MinHeight="124">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Address}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding ProtocolAddress}" Style="{StaticResource MicroTextStyle}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MicroTextStyle}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource Brush.Primary}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RecordsPageViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="检测记录" Style="{StaticResource PageTitleTextStyle}" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="刷新"
                                Command="{Binding RefreshCommand}"
                                AutomationProperties.AutomationId="RecordsRefreshButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                    <ListView ItemsSource="{Binding Records}" Style="{StaticResource ThemedListViewStyle}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="时间" DisplayMemberBinding="{Binding Time}" Width="180" />
                                <GridViewColumn Header="工位" DisplayMemberBinding="{Binding Station}" Width="90" />
                                <GridViewColumn Header="产品条码" DisplayMemberBinding="{Binding ProductCode}" Width="160" />
                                <GridViewColumn Header="P1(kPa)" DisplayMemberBinding="{Binding P1}" Width="110" />
                                <GridViewColumn Header="P2(kPa)" DisplayMemberBinding="{Binding P2}" Width="110" />
                                <GridViewColumn Header="漏率" DisplayMemberBinding="{Binding LeakRate}" Width="110" />
                                <GridViewColumn Header="结果" DisplayMemberBinding="{Binding Result}" Width="90" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource Brush.Page}" Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="22">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="58"
                                Height="58"
                                Background="{DynamicResource Brush.PrimarySoft}"
                                BorderBrush="{DynamicResource Brush.Primary}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid Margin="7">
                                <Border Background="{StaticResource Brush.SurfaceMuted}"
                                        BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="9" />
                                <Path Fill="{DynamicResource Brush.Primary}"
                                      Stretch="Fill"
                                      Margin="13,7,13,11"
                                      Data="M 20,0 C 29,11 37,21 37,31 C 37,43 29,52 20,52 C 11,52 3,43 3,31 C 3,21 11,11 20,0 Z" />
                                <Path Stroke="{StaticResource Brush.White}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Opacity="0.95"
                                      Data="M 22,11 L 22,22 L 15,29" />
                                <Path Stroke="{DynamicResource Brush.PrimarySoft}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 30,17 L 36,17 M 12,36 L 6,36 M 30,34 L 36,39" />
                                <Ellipse Width="5" Height="5" Fill="{StaticResource Brush.Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,3,0" />
                                <Ellipse Width="4" Height="4" Fill="{StaticResource Brush.Accent}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,4" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="中央净软" Style="{StaticResource PanelTitleTextStyle}" />
                            <TextBlock Text="气检工装控制台" Style="{StaticResource MicroTextStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{StaticResource Brush.SurfaceMuted}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,4,0,18">
                        <StackPanel>
                            <TextBlock Text="本机工位" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{Binding Hardware.StationName}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.PrimaryDark}"
                                       Margin="0,4,0,12" />
                            <UniformGrid Columns="2">
                                <Button Content="工位 1"
                                        Command="{Binding SwitchStationCommand}"
                                        CommandParameter="1"
                                        Padding="0"
                                        MinHeight="46"
                                        Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Hardware.ActiveStationId}" Value="1">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="工位 2"
                                        Command="{Binding SwitchStationCommand}"
                                        CommandParameter="2"
                                        Padding="0"
                                        MinHeight="46">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Hardware.ActiveStationId}" Value="2">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource NavButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Key}" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border CornerRadius="8"
                            Padding="16"
                            MinHeight="100"
                            Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Brush.SurfaceMuted}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RunPage.ResultText}" Value="OK">
                                        <Setter Property="Background" Value="{StaticResource Brush.Ok}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Ok}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RunPage.ResultText}" Value="NG">
                                        <Setter Property="Background" Value="{StaticResource Brush.Ng}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Ng}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RunPage.ResultText}" Value="STOP">
                                        <Setter Property="Background" Value="{StaticResource Brush.Warn}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Warn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="检测结果" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryDark}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RunPage.ResultText}" Value="OK">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RunPage.ResultText}" Value="NG">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RunPage.ResultText}" Value="STOP">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding RunPage.ResultText}" FontSize="52" FontWeight="SemiBold" Margin="0,12,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryDark}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RunPage.ResultText}" Value="OK">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RunPage.ResultText}" Value="NG">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RunPage.ResultText}" Value="STOP">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding RunPage.StageText}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MicroTextStyle}">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RunPage.ResultText}" Value="OK">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RunPage.ResultText}" Value="NG">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RunPage.ResultText}" Value="STOP">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Brush.PrimaryDark}"
                            CornerRadius="8"
                            Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource Brush.White}" VerticalAlignment="Center">
                                <Grid Margin="4">
                                    <Path Fill="{DynamicResource Brush.Primary}"
                                          Stretch="Fill"
                                          Margin="5,1,5,2"
                                          Data="M 20,0 C 29,11 37,21 37,31 C 37,43 29,52 20,52 C 11,52 3,43 3,31 C 3,21 11,11 20,0 Z" />
                                    <Path Stroke="{StaticResource Brush.White}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M 11,7 L 11,13 L 7,16" />
                                    <Ellipse Width="3" Height="3" Fill="{StaticResource Brush.Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,2,0" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="工管技术中心智造" Foreground="{StaticResource Brush.White}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Technology Center" Foreground="{DynamicResource Brush.PrimarySoft}" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="2"
                        Content="{Binding CurrentPage}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
